# RedTec Informática - Protección de Raíz y Redirección a /public

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redireccionar todas las peticiones a la carpeta /public
  RewriteCond %{REQUEST_URI} !^/public/
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Bloquear acceso directo a carpetas sensibles del sistema
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>
